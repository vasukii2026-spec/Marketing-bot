# Rename this file to ".env" (remove ".example" from the filename)
# Then paste your real keys in below, replacing the placeholder text.

GROQ_API_KEY=paste_your_groq_key_here
DISCORD_WEBHOOK_URL=paste_your_discord_webhook_url_here

# --- Mastodon (free, no app review) ---
# Preferences -> Development -> New application (check "write" scope) ->
# copy the Access Token. MASTODON_INSTANCE is just your instance's domain,
# no https:// (e.g. mastodon.social).
MASTODON_INSTANCE=paste_your_instance_domain_here
MASTODON_ACCESS_TOKEN=paste_your_mastodon_token_here

# --- Scheduled auto-generation (optional) ---
# Vercel automatically sends this as a Bearer token when it triggers the
# cron job defined in vercel.json — set it to any random string and you're
# done, no extra wiring needed.
CRON_SECRET=paste_a_random_string_here
# Optional: comma-separated topics for auto-generation to rotate through.
# If unset, a sensible built-in list is used (see generator.py).
# AUTO_TOPICS=topic one, topic two, topic three

# Postgres connection string — required. On Vercel: Storage tab -> Create
# Database -> Postgres -> connect it to this project, and Vercel fills
# this in automatically. Locally, use any Postgres instance (Neon's free
# tier works, or a local Postgres).
DATABASE_URL=paste_your_postgres_connection_string_here

# Vercel Blob token — required for image/video uploads on drafts. On
# Vercel: Storage tab -> Create Database -> Blob -> connect it to this
# project, and this gets filled in automatically. If you don't attach
# media to posts, you can skip this.
BLOB_READ_WRITE_TOKEN=paste_your_blob_token_here

# Random string used to sign Flask's session cookie. Any long random
# string works — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=paste_a_random_string_here

# --- Login (password + 2FA) ---
# The password you'll type in to reach the dashboard.
ADMIN_PASSWORD=paste_a_password_you_choose_here

# The 2FA secret, used to check the 6-digit code from your authenticator
# app. Generate one with:
#   python -c "import pyotp; print(pyotp.random_base32())"
# Then add it to Google Authenticator / Authy / 1Password as a manual
# entry (account name can be anything, e.g. "Vasukii Bot") using this
# same secret string.
TOTP_SECRET=paste_the_generated_secret_here

# Bluesky (optional — only needed if you use the Bluesky tab)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=paste_your_app_password_here

# Telegram (optional — only needed if you use the Telegram tab)
TELEGRAM_BOT_TOKEN=paste_your_bot_token_here
TELEGRAM_CHAT_ID=@yourchannelname
